# Kopieer naar Vercel → Project → Settings → Environment Variables
# (of naar .env voor lokaal testen — commit .env NOOIT)

# Upstash Redis (REST) — maak een gratis database op upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Interne sleutel voor de admin (verzin een lange, willekeurige string)
INTERNAL_KEY=

# Geheim voor het ondertekenen van personeel-cookies (mag = INTERNAL_KEY zijn)
STAFF_SECRET=
